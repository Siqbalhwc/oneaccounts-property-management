+                    "label": c["label"],
+                    "amount": c["amount"],
+                    "recurrence": c["recurrence"],
+                    "effective_from": str(lease["start_date"]),
+                    "show_on_invoice": True,
+                }
+                for c in w["to_add"]
+            ]
+            inserted = supabase.table("lease_charges").insert(new_rows).execute().data or []
+            for ch in inserted:
